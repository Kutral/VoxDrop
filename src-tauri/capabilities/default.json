{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the dashboard and the dictation pill",
  "windows": [
    "main",
    "pill"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://console.groq.com/*"
        },
        {
          "url": "https://cloud.cerebras.ai/*"
        },
        {
          "url": "https://github.com/Kutral/VoxDrop/*"
        }
      ]
    }
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxDrop",
  "version": "0.0.15",
  "identifier": "com.voxdrop.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoxDrop",
        "label": "main",
        "width": 720,
        "height": 780,
        "minWidth": 480,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.groq.com https://api.cerebras.ai https://api.github.com",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
